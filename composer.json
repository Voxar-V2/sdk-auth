{
    "name": "voxar/auth-sdk",
    "description": "Client Laravel de Voxar Auth : connexion SSO, déconnexion et API des comptes Voxar.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Voxar\\AuthSdk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voxar\\AuthSdk\\VoxarAuthServiceProvider"
            ],
            "aliases": {
                "VoxarAuth": "Voxar\\AuthSdk\\Facades\\VoxarAuth"
            }
        }
    },
    "minimum-stability": "stable"
}
